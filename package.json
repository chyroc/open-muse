{
  "name": "open-muse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write src server shared tests scripts vite.config.ts capacitor.config.ts README.md",
    "dev": "concurrently -k -n api,app \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "native:sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "macos:build": "npm run build && node scripts/build-macos.mjs",
    "ios:build": "npm run build && cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath .build/ios CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES build -quiet",
    "ios:build:device": "npm run build && cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath .build/ios-device CODE_SIGN_STYLE=Automatic build -quiet"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@volcengine/openapi": "^1.36.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.12",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
