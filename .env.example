# Defaults to demo mode; you can sign in with SSO or enter an API key in the app. Set to ark to use the API key from environment variables.
MUSE_MODE=demo
HOST=127.0.0.1
PORT=4311
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_PROJECT_NAME=
ARK_AGENT_ID=
ARK_ENVIRONMENT_ID=
# Optional: auto-configuration prefers this model; when empty, a text model that supports tool calls is selected from /models.
ARK_MODEL_ID=
# SSO uses the production identity system by default and does not automatically reuse staging credentials.
MUSE_SSO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Required when listening on a non-loopback address; protects the single-user BFF. It is not an Ark API key.
MUSE_ACCESS_TOKEN=
# Comma-separated. Native apps use capacitor://localhost / https://localhost.
MUSE_ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:4310,capacitor://localhost,https://localhost
MUSE_DATA_DIR=.data
