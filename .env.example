# 默认 demo；可在 App 中使用 SSO 或输入 API Key。环境变量 API Key 方式设为 ark。
MUSE_MODE=demo
HOST=127.0.0.1
PORT=4311
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_PROJECT_NAME=
ARK_AGENT_ID=
ARK_ENVIRONMENT_ID=
# 可选：自动配置优先使用此模型；留空时从 /models 选择支持工具调用的文本模型。
ARK_MODEL_ID=
# SSO 默认使用生产身份体系，不自动复用测试环境凭据。
MUSE_SSO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 监听非回环地址时必须设置，用于保护单用户 BFF；不是方舟密钥。
MUSE_ACCESS_TOKEN=
# 逗号分隔。原生 App 使用 capacitor://localhost / https://localhost。
MUSE_ALLOWED_ORIGINS=http://localhost:4310,http://127.0.0.1:4310,capacitor://localhost,https://localhost
MUSE_DATA_DIR=.data
