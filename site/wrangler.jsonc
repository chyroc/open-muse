// The public website at getopenmuse.com: the static pages built into
// .build/site, behind site/worker.js, which sends mainland China visitors to
// the cn.getopenmuse.com mirror and Android downloads to the nearer mirror.
// Deploy with `node site/deploy.mjs` (see docs/development.md).
{
  "name": "open-muse-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "../.build/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "getopenmuse.com", "custom_domain": true },
    { "pattern": "www.getopenmuse.com", "custom_domain": true }
  ]
}
